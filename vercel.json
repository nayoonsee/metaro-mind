{
  "version": 2,
  "builds": [
    { "src": "api/reading.js", "use": "@vercel/node" },
    { "src": "api/saju.js", "use": "@vercel/node" },
    { "src": "api/teaser.js", "use": "@vercel/node" },
    { "src": "api/prototype-generate-chapter.js", "use": "@vercel/node" },
    { "src": "saju.html", "use": "@vercel/static" },
    { "src": "fortune.html", "use": "@vercel/static" },
    { "src": "report.html", "use": "@vercel/static" },
    { "src": "data/**", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/reading", "dest": "/api/reading.js" },
    { "src": "/api/saju", "dest": "/api/saju.js" },
    { "src": "/api/teaser", "dest": "/api/teaser.js" },
    { "src": "/api/prototype-generate-chapter", "dest": "/api/prototype-generate-chapter.js" },
    { "src": "/saju", "dest": "/saju.html" },
    { "src": "/fortune", "dest": "/fortune.html" },
    { "src": "/report", "dest": "/report.html" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
